DEBUG=True

SECRET_KEY=your-secret-key

ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=myproject
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_TLS=True
EMAIL_HOST=your_email_host
EMAIL_PORT=587
EMAIL_FROM=your_email_from
EMAIL_HOST_USER=your_email_host_user
EMAIL_HOST_PASSWORD=your_email_host_password

CELERY_BROKER_URL=redis://127.0.0.1:6379/0

ADMIN_URL=your_admin_url
FRONTEND_URL=your_frontend_url
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Lecture video uploads go directly from the browser to a private S3 bucket.
# In production prefer the EC2 task/instance role over static AWS credentials.
AWS_STORAGE_BUCKET_NAME=your-private-video-bucket
AWS_REGION=ap-south-1
S3_MULTIPART_PART_SIZE=16777216
S3_PRESIGNED_URL_TTL=900
MAX_LECTURE_VIDEO_SIZE=8589934592
CLOUDFRONT_DOMAIN=https://videos.example.com

# Browser JWT cookies: false only for local HTTP development; true for HTTPS.
AUTH_COOKIE_SECURE=False
# Use None only for cross-site HTTPS deployments (also requires Secure cookies).
AUTH_COOKIE_SAMESITE=Lax
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOW_CREDENTIALS=True

# Production course catalog search (OpenSearch)
OPENSEARCH_URL=https://your-opensearch-domain
OPENSEARCH_INDEX=courses
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_USE_SSL=True
OPENSEARCH_VERIFY_CERTS=True
